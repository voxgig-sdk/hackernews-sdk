# Entity: user

main: kit: entity: user: {

  alias: field: {}

  fields: [
    {
      name: "about"
      req: false
      short: "The user's optional self-description."
      type: "`$STRING`"
    }
    {
      name: "created"
      req: true
      short: "Creation date of the user, in Unix Time"
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: true
      short: "The user's unique username."
      type: "`$STRING`"
    }
    {
      name: "karma"
      req: true
      short: "The user's karma"
      type: "`$INTEGER`"
    }
    {
      name: "submitted"
      req: false
      short: "List of the user's stories, polls and comments"
      type: "`$ARRAY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "user"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "print"
                orig: "print"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/user/{id}.json"
          segments: [
            {
              lit: "user"
            }
            {
              lit: "{id}.json"
            }
          ]
          select: {
            "$action": "id"
            exist: [
              "id"
              "print"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.submitted`"
          }
        }
      ]
    }
  }



}
